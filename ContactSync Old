function createAndRenameTabById() {
  const spreadsheetId = "1LlZXVYx4nEtJOkG4Vedt5342mzTegEtIgGtiQA0HvXc"; // Your spreadsheet ID
  const newTabName = "qryExportField";

  Logger.log(`Attempting to open spreadsheet with ID: ${spreadsheetId}`);

  try {
    const spreadsheet = SpreadsheetApp.openById(spreadsheetId);
    Logger.log(`Successfully opened spreadsheet: ${spreadsheet.getName()}`);

    // Check if a sheet with the desired name already exists
    const existingSheet = spreadsheet.getSheetByName(newTabName);
    if (existingSheet) {
      Logger.log(`Sheet "${newTabName}" already exists. Creating a new one with a unique name.`);
      // If you want to always create a new one even if one exists,
      // you could add a timestamp or number to the name, e.g.,
      // newSheet.setName(`${newTabName}_${new Date().getTime()}`);
      // For now, we'll just proceed to create a new one, and it will get a default name
      // that we'll then rename. If you want to _replace_ the existing one, that's a different
      // operation (delete existing, then create new).
    }

    // Add a new sheet (tab) to the spreadsheet
    const newSheet = spreadsheet.insertSheet();
    Logger.log(`New sheet created with default name: ${newSheet.getName()}`);

    // Rename the newly created sheet
    newSheet.setName(newTabName);
    Logger.log(`New sheet renamed to: ${newTabName}`);


    newSheet.insertRows(1,2000);
    // Optional: Alert the user in the UI (only works if running from the bound script)
//    SpreadsheetApp.getUi().alert('Success!', `New tab "${newTabName}" created successfully in spreadsheet "${spreadsheet.getName()}".`, SpreadsheetApp.getUi().ButtonSet.OK);

  } catch (error) {
    // Log any errors that occur and alert the user
    Logger.log(`Error in createAndRenameTabById: ${error.toString()}`);
    SpreadsheetApp.getUi().alert('Error', `An error occurred: ${error.message}. Check the Apps Script logs for more details.`, SpreadsheetApp.getUi().ButtonSet.OK);
  }
}









