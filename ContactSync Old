function CheckMaxComputerTimeForDay() {
  // Retreive the amount of machine time the script used for the day.
  // If the machine time is to much, the function will exit with custom error which is logged in Debug Sheet
  // The global variable sCompTime determines the amount of machine time this script may use

  gvComputerTime = Number(gvSyncVarsSheet.getRange(sComputerTime).getValue());
  if (gvComputerTime > sCompTime)
    throw new Error("Max Computer Time Reached");
}

function MeetingIsInUpdateSchedule(aContactMtg) {
  // This function checks if the meeting must be synced to the user's Google Contacts

  // Get the meeting row in the qryExportField sheet in the user's Update Schedule Google Sheet
  var aMtgRow = GetMeetingRow(aContactMtg);
  if (aMtgRow == -1)
    return false;

  var aProvince = gvMeetingData[aMtgRow][0];
  var aField = gvMeetingData[aMtgRow][1];
  var aMtg = gvMeetingData[aMtgRow][2];

  if (gvUpdateScheduleData == null) {
    gvUpdateScheduleData = gvUpdateScheduleSheet.getRange("A2:H60");
    gvUpdateScheduleDataValues = gvUpdateScheduleData.getValues();
  }

  var aResult = false;

  for (var i = 0; (i < gvUpdateScheduleDataValues.length - 1); ++i) {
    var row = gvUpdateScheduleDataValues[i];
    var asField = row[0];
    var asMustUpdate = row[7];

    if ((asField.toUpperCase() == aProvince.toUpperCase()) || (asField.toUpperCase() == aField.toUpperCase()) || (asField.toUpperCase() == aMtg.toUpperCase()))
      aResult = true;
  }

  return aResult;
}

function copySheetData(sourceSheet, targetSheet) {
  var sourceRange = sourceSheet.getDataRange(); // Get all data from source sheet
  var data = sourceRange.getValues(); // Read data into an array
  
  targetSheet.getRange("A:T").setNumberFormat("@"); //19/03/2026 Marius - Force all columns to text. Fixes problem with leading 0 not being copied

  targetSheet.getRange(1, 1, data.length, data[0].length).setValues(data); // Write data to target sheet
}




function MakeDataSnapshot() {
  // 16 seconds

  // This function copies all the data from the Main RSA Address book Google Sheet to the user's Update Schedule Sheet
  WriteDebugMSG("Making Snapshot started");

