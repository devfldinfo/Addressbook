      aProcessedDataRange[gvTmpi][7] = '=if(iserror(vlookup(I' + t + ',ContactLog!$J$1:$J$8000,1,false)),"Not found","")';
      //Marius 07/07/2024 Added This Column And Changed Lookup Above
      aProcessedDataRange[gvTmpi][8] = "=CONCATENATE (B"+t+",G"+t+")";
    }
  }
  }catch(e)
   { WriteDebugMSG("**** Error Processing contact "+e.message);}
}

