function UpdateContacts() {
  // This is the main function of the script.
  // When the triggers are created for a new user, this is the function that will run on the specified schedule.
  try {
    try {
      // If the Development flag is set to true, the function will exit immediatly
      // This is a global variable that can be found at the top if the script
      if (aBusyDeveloping)
        return;

      // Get the current minute and hour
      // The hour is 24 hour format. 1-24
      aMin = Utilities.formatDate(new Date(), "GMT+2", "m");
      aHour = Number(Utilities.formatDate(new Date(), "GMT+2", "k"));

      DoTesting();

      // Open the Spreadsheet
      gvRSAAddressBook = SpreadsheetApp.openById(gvAddressbookID);

      // If the Spreadsheet cannot be opened, the function exits
      if (gvRSAAddressBook == null)
        return;

      //Marius - Added function to uninstall AddressBook
      // To uninstall user, add their email address to the Uninstall sheet in the RSAAddressbook spreadsheet
      if (Uninstalled())
        return;

      if (aHour > 10)
        return;

      if (aMin > 31)
        return;

      GetUpdateScheduleSheet();
      //getOrCreateTab(gvUpdateSchedule,"qryExportField");
      //getOrCreateTab(gvUpdateSchedule,"Data");

      // Get the Debug Log sheet in the Update schedule Spreadsheet of the specific user.
      // All Debug info is written in the Debug Sheet
      gvDebugSheet = getSheetInUpdateSchedule("Debug");
      if (gvDebugSheet.getMaxRows() < 2000)
        gvDebugSheet.insertRowsAfter(gvDebugSheet.getMaxRows(), 2000);

      gvErrorSheet = getSheetInUpdateSchedule("ErrorLog");

      // A message is written in the Debug Log for the specific user
      WriteDebugMSG(aVersion + " - - - Start to Update Contacts");

      gvSyncVarsSheet = getSheetInUpdateSchedule('Sync Variables');

      gvSyncVarsSheet.getRange("B7").setValue(aVersion);

      //  gvDoCleanup=gvSyncVarsSheet.getRange("B9").getValue();


      // throw new Error("Checking...");

      CheckIfScriptIsRunning();

      if (aHour == 3)
        ClearCounters();

      CheckSyncDisabled();
      CheckMaxComputerTimeForDay();

      // Get Data from Spreadsheet. 10 seconds
      // Some maintenance routines use it too.
      GetContactData();
      GetMeetingData();

      // The Contacts are processed row by row from the Data sheet in the user's Update Schedule spreadsheet.
      // To keep track as to which row is being updated, the row number is stored in the user's Sync Variables sheet in the Update Schedule spreadsheet
      var tmp = gvSyncVarsSheet.getRange(sUpdatingRow).getValue();
      var aLastRowStopped = 0;
      aLastRowStopped = Number(tmp);

      // The last Updated Date is retrieved from the Sync Variables sheet
      // if the Last Update Date in the user's Sync Variables sheet is blank, 
      // a default date of 1 Jan 1950 is used which will ensure that all rows will be updated in the user's Google account 
      gvLastUpdatedDate = gvSyncVarsSheet.getRange(sLatestUpdateDate).getValue();
      if ((gvLastUpdatedDate == "") || (gvLastUpdatedDate == null))
        gvLastUpdatedDate = new Date("01/01/1950 01:01:01")

      try //Check if date is valid
      {
        var tmpt = gvLastUpdatedDate.getTime();
      }
      catch (e) {
        var twoweeks = 1000 * 60 * 60 * 24 * 14;
        var now = new Date();
        gvLastUpdatedDate = new Date(now.getTime() - twoweeks);
        WriteDebugMSG("Last Update Date is not valid. Please fix data: ");
      }

      if ((aHour > 3) && (aHour < 22) && (aMin < 16)) //20/01/2022 Marius
      {
        LogContacts();
        //   gvSyncVarsSheet.getRange(sContactCount).setValue(gvLogContacts.length);
        throw new Error("Contacts Logged");
      }

      var aRefreshContacts = gvSyncVarsSheet.getRange(sRefreshContacts).getValue();
      if(!isCellEmpty(aRefreshContacts))
      {
        WriteDebugMSG("START - DELETING ALL CONTACTS!!!!");
        DeleteAllContacts(null);
        WriteDebugMSG("FINISHED - DELETING ALL CONTACTS!!!!");
        gvSyncVarsSheet.getRange(sLatestUpdateDate).setValue(null);
        gvSyncVarsSheet.getRange(sUpdatingRow).setValue(0);
        gvSyncVarsSheet.getRange(sRefreshContacts).setValue(null);
        gvSyncVarsSheet.getRange(sIsRunning).setValue(null);
        throw new Error("All contacts deleted");
      }

      //  if ((aHour>5)&&(aHour<22))
      //   throw new Error("Updates are only done between 22:00 and 05:00");

      WriteDebugMSG("Start loading contacts into memory");
      //  gvGoogleContactCount=0;
      RefreshContactsCache(null);
      LoadContactsIntoMemory(null);
      // LogUUIDs();
      WriteDebugMSG("End loading contacts into memory");

      gvMyContactsGoogleGroup = DoGetContactGroup("myContacts", false)["resourceName"];

      //gvSyncVarsSheet.getRange(sContactCount).setValue(gvGoogleContactCount);

      if ((aHour > 4) && (aHour < 22) && (aMin > 15)) {
        CheckContacts();
        throw new Error("Contacts checked");
      }

      if ((aHour > 5) && (aHour < 22))
        throw new Error("Updates are only done between 22:00 and 05:00");

      // Iterate through the Data starting from where the script stopped last
      for (var i = aLastRowStopped; i < gvData.length; i++) {
        CheckScriptRunningTime();

        // The UUID for the row is stored in the 20th column
        // To reference the 20th column, 19 is used because the columns start with 0
        var tmpUserID = gvData[i][19];

        // If the UUID is blank, go to the next line. might be more data
        if (tmpUserID == "")
          continue;

        // Get the modified date of the row
        // When the data in the main Address Book spreadsheet is changed, the date and time is written in the 15th column
        // if the Modified Date is blank, a default date of 1 Jan 2010 is used which will ensure that the row is updated in the user's Google account 
        var aModDate = gvData[i][14];

        try //Check if date is valid
        {
          var tmpt = aModDate.getTime();
        }
        catch (e) {
          aModDate = "";
          var tmpNameError = gvData[i][1];
          var tmpSurnameError = gvData[i][0];
          WriteDebugMSG("Modified Date is not valid. Please fix data: " + tmpSurnameError + " " + tmpNameError + " - " + tmpUserID);
        }

        if ((aModDate == "") || (aModDate == null))
          aModDate = new Date();

        // If the modified date of the row is bigger than the last update date (the last time an update was done), then the row is updated 
        // in the user's Google Contacts
        if ((aModDate.getTime() > gvLastUpdatedDate.getTime())) {
          UpdateContact(i);
        }

        if ((gvContactCount > 190) || (gvContactsToDelete.length > 490))//The batchCreate limit is 200 per call. The batchDelete limit is 500 per call
          CommitChanges(i);
      }

      CommitChanges(i);

      if (i >= gvData.length) {
        gvSyncVarsSheet.getRange(sLatestUpdateDate).setValue(gvDataSheet.getRange("O1").getValue());
        MakeDataSnapshot();
        gvSyncVarsSheet.getRange(sUpdatingRow).setValue(0);
      }
    }
    catch (e) {
      WriteDebugMSG(e.message);
    }

    gvSyncVarsSheet.getRange(sIsRunning).setValue(null);
    WriteDebugMSG("End of UpdateContacts " + gvComputerTime);
  }
  catch (e) { }
}

function UpdateContact(i) {
  // A Check is done to see if the row that must be updated is in the user's selected update list.
  // The user can select the Districts, fields and meetings that must be synced to the user's Google Contacts
  if (MeetingIsInUpdateSchedule(gvData[i][11])) {
    var aneweldergroup = null;
    var aMtgRow = GetMeetingRow(gvData[i][11]);
    var aField = gvMeetingData[aMtgRow][1];

    if (gvData[i][9].toUpperCase() == "Y") // Is Elder
      aneweldergroup = aField + " - Elders";

    RefreshContact(gvData[i], aField, aneweldergroup);
  }
  else
    DeleteContactsWithUUID(gvData[i][19]); //This contact is not part of the selected groups to sync
}

function CheckContacts() {
  WriteDebugMSG("Checking Contacts Started...");
  var aData = getSheetInUpdateSchedule("VerifyContacts").getDataRange().getValues();
  var aCData = getSheetInUpdateSchedule("ContactLog").getDataRange().getValues();

  if ((aData[0][0] == "") || (aCData[0][0] == ""))
    throw new Error("ContactLog or VerifyContacts sheet is empty");

  for (var i = 0; i < aData.length; i++) {
    CheckScriptRunningTime();

    if (aData[i][7] == "Not found") {
      if (!UUIDHasBeenRefreshed(i, aData[i][6], aData)) {
        var aRow = GetContactRowNo(aData[i][6]);

        if (aRow > -1) {
          WriteDebugMSG("Updating missing contact:" + gvData[aRow][0] + " " + gvData[aRow][1]);
          UpdateContact(aRow);
        }
      }
    }

    if ((gvContactsToAdd.length > 190) || (gvContactsToDelete.length > 190))
      CommitChanges(0);
  }

  CommitChanges(0);

  aCData = getSheetInUpdateSchedule("ContactLog").getDataRange().getValues();
  for (var i = 0; i < aCData.length; i++) {
    CheckScriptRunningTime();

    if (aCData[i][7] == "Duplicate") {
      if (!UUIDHasBeenRefreshed2(i, aCData[i][5], aCData)) {
        var aRow = GetContactRowNo(aCData[i][5]);

        if (aRow > -1) {
          WriteDebugMSG("Updating duplicate contact:" + gvData[aRow][0] + " " + gvData[aRow][1]);
          UpdateContact(aRow);
        }
      }
    }
    else if (aCData[i][8] == "Bogus UUID"){//Marius 23/02/2026
      if (!UUIDHasBeenRefreshed2(i,aCData[i][5], aCData)) {
        var aRow = GetContactRowNo(aCData[i][5]);

        if (aRow > -1) {
          WriteDebugMSG("Deleting Bogus UUID: "+ aCData[i][5] + " " + aCData[i][1]);

          UpdateContact(aRow);
        //DeleteContactsWithUUID(aCData[i][5]);
        }}
      }






    if (aCData[i][5] == "") {
      WriteDebugMSG("Contact with no UUUID found: " + aCData[i][1]);
      DeleteContactsWithUUID("");
    }

    if ((gvContactsToAdd.length > 190) || (gvContactsToDelete.length > 190))
      CommitChanges(0);
  }

  CommitChanges(0);

  WriteDebugMSG("Checking Contacts Ended...");
}

function UUIDHasBeenRefreshed2(aRowNo, aUUID, aData) {
  for (var i = 0; i < aRowNo; i++) {
    if ((aData[i][5] == aUUID) && (aData[i][7] == "Duplicate"))
      return true;
  }

  return false;
}

function UUIDHasBeenRefreshed(aRowNo, aUUID, aData) {
  for (var i = 0; i < aRowNo; i++) {
    if ((aData[i][6] == aUUID) && (aData[i][7] == "Not found"))
      return true;
  }

  return false;
}

function GetContactRowNo(aUUID) {
  var aResult = -1;

  for (var i = 0; i < gvData.length; i++) {
    if (gvData[i][19] == aUUID) {
      aResult = i;
      break;
    }
  }

  return aResult;
}

function CommitChanges(aRowNo) {
  //This function does the batch create and delete of contacts.
  WriteDebugMSG("Commiting changes... gvContactCount:" + gvContactCount);

  if (gvContactsToAdd.length > 0) {
    var acreateresponse = People.People.batchCreateContacts({ "contacts": gvContactsToAdd, "readMask": "names" });

    var agroupmembers = [];
    for (var agrp = 0; agrp < acreateresponse.createdPeople.length; agrp++)
      agroupmembers.push(acreateresponse.createdPeople[agrp].requestedResourceName);

    People.ContactGroups.Members.modify({ "resourceNamesToAdd": agroupmembers }, gvMyContactsGoogleGroup);
  }

  //  Utilities.sleep(5000); //9/12/2021 Marius - Commented out

  if (gvContactsToDelete.length > 0)
    People.People.batchDeleteContacts({ "resourceNames": gvContactsToDelete });

  gvContactsToAdd = [];
  gvContactsToDelete = [];
  gvContactCount = 0;

  if (aRowNo == 0)
    aRowNo = -1;

  gvSyncVarsSheet.getRange(sUpdatingRow).setValue(aRowNo + 1);
}

function DoGetContactGroup(aName, aCreate) {
  //Marius 29/06/2021 - Creates Group if not exist and aCreate is true

  var groups = People.ContactGroups.list({ "pageSize": 1000 })["contactGroups"];
  var group = groups.find(group => group["name"] === aName);

  if (!group && aCreate) {
    var groupResource = { contactGroup: { name: aName } }
    group = People.ContactGroups.create(groupResource);
    Utilities.sleep(1000); //needed otherwise gives error
    return DoGetContactGroup(aName, false);
  }

  return group;
}

