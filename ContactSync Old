function writeUpdateScheduleFilesToSheet() {
  // Get the spreadsheet by ID
  const spreadsheetId = "1ZgFuwucs_0v9CsBbphHfE6U0b0D-lEPPCsldQr_DUBw";
  const spreadsheet = SpreadsheetApp.openById(spreadsheetId);
  
  // Get the "Users" sheet
  const sheet = spreadsheet.getSheetByName("Users");
  if (!sheet) {
    Logger.log("Sheet 'Users' not found.");
    return;
  }
  
  // Search for files ending with "- UpdateSchedule"
  const files = DriveApp.searchFiles('title contains "- UpdateSchedule"');
  
  // Prepare array to store file names and links
  const fileData = [];
  
  // Iterate through files and collect names and links
  while (files.hasNext()) {
    const file = files.next();
    fileData.push([file.getName(), file.getUrl()]);
  }
  
  // Sort fileData by file name (first element of each sub-array)
  fileData.sort((a, b) => a[0].localeCompare(b[0]));
  
  // Clear existing content in columns H and I starting from row 1
  const lastRow = sheet.getLastRow();
  if (lastRow >= 1) {
    sheet.getRange(1, 8, lastRow, 2).clearContent();
  }
  
  // Write sorted file names to column H and links to column I starting from row 1
  if (fileData.length > 0) {
    sheet.getRange(1, 8, fileData.length, 2).setValues(fileData);
  } else {
    Logger.log("No files found with '- UpdateSchedule' in the name.");
  }
}
