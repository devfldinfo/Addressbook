/**
 * Gets a tab by name from a Google Spreadsheet. If the tab doesn't exist, it creates a new one
 * with the specified name and adds 1000 rows to it.
 *
 * @param {GoogleAppsScript.Spreadsheet.Spreadsheet} aSpreadsheet The Google Spreadsheet object.
 * @param {string} aName The name of the tab to find or create.
 * @returns {GoogleAppsScript.Spreadsheet.Sheet} The Spreadsheet tab object.
 */
function getOrCreateTab(aSpreadsheet, aName) {
  let tab = aSpreadsheet.getSheetByName(aName); // Try to get the tab by name

  if (tab) {
    // If the tab exists, return it
    return tab;
  } else {
    // If the tab does not exist, create it
    tab = aSpreadsheet.insertSheet(aName);
    // Insert 1000 lines at the end of the new tab
    //tab.insertRowsAfter(tab.getMaxRows(), 1000);
    return tab;
  }
}


