function FormatNumber(aNumber, aDistrict) {
  var tmpstr = RemoveNonNumerics(aNumber);

  if (tmpstr.length > 0) {
    if (tmpstr.length > 9) {
      var tmpLast = tmpstr.substr(tmpstr.length - 4);

      var tmpMiddle = tmpstr.substr(tmpstr.length - 7, 3);

      var tmpFirst = tmpstr.substr(0, tmpstr.length - 7);

      tmpstr = tmpFirst.concat(" ", tmpMiddle, " ", tmpLast);
    }

    if ((tmpstr.charCodeAt(0) == 48) &&
      (tmpstr.charCodeAt(1) == 48)) //0
    {
      tmpstr = tmpstr.substr(2);

      tmpstr = GetCountryCode(aDistrict).concat(tmpstr);
    }
    else
      if (tmpstr.charCodeAt(0) == 48) //0
      {
        tmpstr = tmpstr.substr(1);

        tmpstr = GetCountryCode(aDistrict).concat(tmpstr);
      }
      else if(tmpstr.charAt(0)!="+")
        tmpstr = GetCountryCode(aDistrict).concat(tmpstr);
  }

  return tmpstr;
}

function GetCountryCode(aDistrict) {
  var aCode = "+27";

  var tmp = "";

  if (gvCountryCodeData == null) {
    gvCountryCodeData = gvMeetingData;
  }

  for (var i = 1; i < gvCountryCodeData.length; ++i) {
    tmp = gvCountryCodeData[i][2];

    if (tmp.toUpperCase() == aDistrict.toUpperCase()) {
      aCode = gvCountryCodeData[i][18];
      break;
    }
  }

  if (aCode == "")
    aCode = '+27';

  return aCode;
}

function GetPhoneField(aPrefix, aNumber) {
  var tmp = "main";
  aPrefix == aPrefix.toUpperCase();

  if (IsMobileNumber(aNumber))
    tmp = "mobile";
  else {
    if (aPrefix == "H" || aPrefix == "(H)" || aPrefix == "HOME")
      tmp = "home"

    if (aPrefix == "W" || aPrefix == "(W)" || aPrefix == "WRK" || aPrefix == "OFFICE")
      tmp = "work";

    if (aPrefix == "T/F" || aPrefix == "FAX" || aPrefix == "<F>" || aPrefix == "(FAX)" || aPrefix == "H/F")
      tmp = "homeFax";
  }

  return tmp;
}

function IsMobileNumber(aNumber) {
  var aMobile = false;

  var tmp2 = 0;

  var tmp = RemoveNonNumerics(aNumber);

  if (tmp[0] == "+") //international numbers are normally mobile numbers?
    aMobile = true
  else {
    if (tmp[0] == "0")
      tmp2 = tmp[1];

    if (Number(tmp2) > 5) //All mobile carriers in SA start from 061
      aMobile = true;
  }

  return aMobile;
}

function GetPrefix(aNumber) {
  var tmp = "";
  var tmp2 = 0;

  for (var i = 0; i < aNumber.length; ++i) {
    tmp2 = aNumber.charCodeAt(i);

    if (((tmp2 < 48) || (tmp2 > 57)) && (tmp2 != 43))
      tmp = tmp.concat(aNumber[i])
    else
      i = aNumber.length;
  }

  return tmp;
}

function GetSuffix(aNumber) {
  var tmp = "";

  var tmp2 = 0;

  for (var i = aNumber.length - 1; i > -1; --i) {
    tmp2 = aNumber.charCodeAt(i);

    if (((tmp2 < 48) || (tmp2 > 57)) && (tmp2 != 43))
      tmp = aNumber[i].concat(tmp);
    else
      i = -1;
  };

  return tmp;
}

function RemoveNonNumerics(aNumber) {
  var tmp = "";

  var tmp2 = 0;

  for (var i = 0; i < aNumber.length; ++i) {
    tmp2 = aNumber.charCodeAt(i);

    if (((tmp2 > 47) && (tmp2 < 58)) || (tmp2 == 43))
      tmp = tmp.concat(aNumber[i]);
  }

  return tmp;
}

