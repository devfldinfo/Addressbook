function LoadContactsIntoMemory(aPToken) {
  //Marius 29/06/2021 - Iterates through all contacts in 14sec
  //  var aContact=[];

  var connections = People.People.Connections.list('people/me',
    {
      pageSize: 2000,//amount of contacts to retrieve. Max is a 2000
      pageToken: aPToken, // The token to send to the next iteration of a 2000
      personFields: 'names,addresses,emailAddresses,phoneNumbers,organizations,biographies' //Details of contact to retrieve
      //    personFields:'names,biographies' //Details of contact to retrieve
    });

  aPToken = connections.nextPageToken;

  //Loop through contacts
  if (connections.connections != null)
    connections.connections.forEach(
      function (person) {
        CheckScriptRunningTime();

        var aContact = [];

        if (person.biographies != null)
          if (person.biographies[0].value.indexOf("UUID") != -1) {
            aContact.push(GetUUIDFromNotes(person.biographies[0].value));
            aContact.push(person.resourceName);
            aContact.push(GetVersionFromNotes(person.biographies[0].value));

            gvContactsData.push(aContact);
            gvGoogleContactCount += 1;
          }
      });

  if (aPToken != null) //If there is no nextPageToken, the end is reached
    LoadContactsIntoMemory(aPToken);
}

function DeleteContactsWithUUID(aUUID) {
  // Marius 04/07/2021 Loops through all contacts and delete contact where UUIDs match
  var tmpUUID = "";

  for (var i = 0; i < gvContactsData.length; i++) {
    tmpUUID = gvContactsData[i][0];

    if (gvContactsData[i][0].localeCompare(aUUID) == 0) {
      //   WriteDebugMSG("Deleting contact with UUID: "+aUUID+" ResourceName: "+gvContactsData[i][1]);
      gvContactsToDelete.push(gvContactsData[i][1]);
    }
